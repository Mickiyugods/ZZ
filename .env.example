# ── Required to run ZEEP live ────────────────────────────────────────────────
# Coin registry (zeep_coins / zeep_vault_events). Supabase → Project Settings → API.
# Without these in production, /api/tokens is empty and /api/register returns 503.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Wallet connect (EVM + the Solana wallet for the Gacha Station). Privy dashboard → App ID.
# Without it the site works, but nobody can connect a wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side Robinhood Chain RPC (Alchemy HTTPS URL). The Alchemy app must have
# "Robinhood Mainnet" enabled. Falls back to public RPCs if empty.
RPC_URL=
# Any long random string — protects /api/cron/keeper (Vercel Cron sends it automatically).
CRON_SECRET=
# The live domain, e.g. https://zeep.xyz — used for share-card (OpenGraph) URLs.
NEXT_PUBLIC_SITE_URL=

# ── Gacha Station (Collector Crypt, Solana) ─────────────────────────────────
# Defaults to devnet so nothing spends real USDC. Set to https://gacha.collectorcrypt.com to go live.
COLLECTORCRYPT_GACHA_URL=https://dev-gacha.collectorcrypt.com
# Optional: gives packs a branded memo slug (contact Collector Crypt). Play works without it.
COLLECTORCRYPT_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Pinata JWT enables logo image uploads on the launch form (file → IPFS).
# Without it, the form falls back to pasting a logo URL.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Only for the AI chat route, which is currently not mounted anywhere — leave empty.
ANTHROPIC_API_KEY=

# ── After the Phase 2 contract deploy (contracts/ignition/modules/ZeepCore.ts) ──
# Leave empty until deployed — the Contracts page shows "Not deployed yet" instead.
NEXT_PUBLIC_ZEEP_LAUNCHER=
NEXT_PUBLIC_ZEEP_EXTERNAL_LAUNCHER=
NEXT_PUBLIC_ZEEP_TREASURY=
